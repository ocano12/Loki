{
  "expo": {
    "name": "WeClude",
    "slug": "inclusive-miami",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inclusive-miami",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.inclusivemiami.app"
    },
    "android": {
      "package": "com.inclusivemiami.app",
      "adaptiveIcon": {
        "backgroundColor": "#88BCDA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#253D89",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#253D89",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
